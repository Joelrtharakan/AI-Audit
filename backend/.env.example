# LLM Provider Configuration:
# - Development / Testing: "ollama" (uses OLLAMA_BASE_URL and OLLAMA_MODEL)
# - Production: "copilot" (uses official GitHub Copilot SDK, COPILOT_MODEL, COPILOT_GITHUB_TOKEN)
# - Router / Fallback Cloud APIs: "groq", "openrouter", "gemini"
LLM_PROVIDER=ollama

# GitHub Copilot SDK (Production)
COPILOT_MODEL=auto
COPILOT_GITHUB_TOKEN=
COPILOT_TIMEOUT_SECONDS=30.0

# Ollama Local Server (Development)
OLLAMA_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434


OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b:free
OPENROUTER_SITE_URL=http://localhost:5500
OPENROUTER_APP_NAME=LQMS-AI

GOOGLE_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# LLM router circuit-breaker/concurrency tuning (defaults are usually fine)
LLM_ROUTER_DEFAULT_COOLDOWN_SECONDS=30
LLM_ROUTER_MAX_COOLDOWN_SECONDS=120
LLM_ROUTER_MAX_CONCURRENCY_PER_PROVIDER=6

# Only used when LLM_PROVIDER=ollama. Requires `ollama serve` running locally with this
# model pulled (`ollama pull qwen2.5:7b-instruct-q4_K_M`).
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M
OLLAMA_BASE_URL=http://localhost:11434/v1

INTERNAL_API_KEY=your_internal_api_key_here

ALLOWED_ORIGINS=http://localhost:5500

LOG_LEVEL=INFO

ANALYSIS_PROMPT_VERSION=1.0
