# =============================================================================
# LLM Provider Configuration
#   - Development / Testing / degraded fallback: "ollama"
#   - "microsoft_copilot" -> M365 Copilot Chat API (Microsoft Entra sign-in)
#   - "github_copilot"    -> GitHub Copilot SDK    (GitHub OAuth sign-in)
#   - Legacy cloud router: "groq", "openrouter", "gemini"
# When a user signs in, LLM_PROVIDER is set per-request from their session
# (github vs microsoft); the value here is the default for unauthenticated calls.
#
# LiteLLM is the single inference boundary. LLM_MODEL is provider-neutral (the
# LiteLLM identifier is derived only at the adapter). ONE provider + ONE model
# are frozen once per investigation. LLM_FALLBACK_ENABLED=false means a failed
# call surfaces the app's degraded / fail-closed behavior -- never a silent
# switch to another provider (when true, retries stay on the SAME provider/model).
# =============================================================================
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:8b
LLM_FALLBACK_ENABLED=false

# -----------------------------------------------------------------------------
# Microsoft 365 Copilot (production)
# Reached through the Microsoft Graph beta Copilot Chat API
# (POST /beta/copilot/conversations then .../{id}/chat), routed via a LiteLLM
# custom provider. Constraints: delegated auth only (no daemon), per-user
# Microsoft 365 Copilot add-on license required, no model selection, text-only
# responses, currently a /beta API.
# -----------------------------------------------------------------------------
MICROSOFT_COPILOT_ENABLED=true
# Local-dev only: paste a delegated Graph access token to skip interactive
# sign-in. In production this is supplied per-request from the Entra session.
MICROSOFT_COPILOT_ACCESS_TOKEN=
MICROSOFT_COPILOT_TIMEOUT_SECONDS=90
MICROSOFT_COPILOT_MAX_RETRIES=2
MICROSOFT_COPILOT_TIMEZONE=UTC
MICROSOFT_COPILOT_WEB_GROUNDING=false
MICROSOFT_GRAPH_BASE_URL=https://graph.microsoft.com

# -----------------------------------------------------------------------------
# Microsoft Entra ID (delegated OAuth 2.0 authorization-code flow)
# Register an app at https://entra.microsoft.com -> App registrations.
# Redirect URI (Web): must match MICROSOFT_REDIRECT_URI below.
# Delegated Graph permissions (admin consent required):
#   Sites.Read.All, Mail.Read, People.Read.All, OnlineMeetingTranscript.Read.All,
#   Chat.Read, ChannelMessage.Read.All, ExternalItem.Read.All
# -----------------------------------------------------------------------------
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:8010/api/auth/microsoft/callback
# Optional: restrict sign-in to a single tenant id.
MICROSOFT_ALLOWED_TENANT_ID=

# -----------------------------------------------------------------------------
# GitHub OAuth + GitHub Copilot -- an ALTERNATIVE sign-in to Microsoft Entra.
# Register an OAuth app at https://github.com/settings/developers.
# Authorization callback URL must match GITHUB_REDIRECT_URI below.
# Users signing in this way need an active GitHub Copilot subscription.
# -----------------------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8010/api/auth/github/callback
# Optional: restrict sign-in to members of one GitHub org (empty = any account).
GITHUB_ALLOWED_ORG=
COPILOT_MODEL=auto
# Local-dev only: paste a GitHub token (ghp_...) to skip interactive sign-in.
COPILOT_GITHUB_TOKEN=
COPILOT_TIMEOUT_SECONDS=90

# Session/token encryption at rest (min 32 chars in production)
SESSION_SECRET=dev-secret-key-change-in-production-min-32-chars

# -----------------------------------------------------------------------------
# Ollama Local Server (development / fallback)
# -----------------------------------------------------------------------------
OLLAMA_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434
# Reasoning-model handling: when OLLAMA_THINKING=false (default) and the
# selected model name contains one of these comma-separated markers, thinking
# is disabled at the Ollama level (via LiteLLM reasoning_effort -> think:false)
# so no <think> tokens are generated. Generic; add markers for other reasoning
# models you run.
OLLAMA_THINKING=false
OLLAMA_THINKING_MODEL_MARKERS=qwen3

# -----------------------------------------------------------------------------
# Legacy cloud router (fallback only)
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b:free
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-flash-latest

LLM_ROUTER_DEFAULT_COOLDOWN_SECONDS=30
LLM_ROUTER_MAX_COOLDOWN_SECONDS=120
LLM_ROUTER_MAX_CONCURRENCY_PER_PROVIDER=6

INTERNAL_API_KEY=your_internal_api_key_here
ALLOWED_ORIGINS=http://localhost:5500
LOG_LEVEL=INFO
ANALYSIS_PROMPT_VERSION=1.0
