# Anything other than "ollama" routes through the multi-provider failover
# router (app/services/llm_router.py): GROQ -> OPENROUTER -> GEMINI, in that
# strict order, automatically failing over on rate limits/errors. Configure
# whichever of the three API keys below you have; providers with no key
# configured are skipped automatically, so a single key alone is sufficient.
# "ollama" bypasses the router entirely for local dev with no cloud keys.
LLM_PROVIDER=groq

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b:free
OPENROUTER_SITE_URL=http://localhost:5500
OPENROUTER_APP_NAME=LQMS-AI

GOOGLE_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# LLM router circuit-breaker/concurrency tuning (defaults are usually fine)
LLM_ROUTER_DEFAULT_COOLDOWN_SECONDS=30
LLM_ROUTER_MAX_COOLDOWN_SECONDS=120
LLM_ROUTER_MAX_CONCURRENCY_PER_PROVIDER=6

# Only used when LLM_PROVIDER=ollama. Requires `ollama serve` running locally with this
# model pulled (`ollama pull qwen2.5:7b-instruct-q4_K_M`).
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M
OLLAMA_BASE_URL=http://localhost:11434/v1

INTERNAL_API_KEY=your_internal_api_key_here

ALLOWED_ORIGINS=http://localhost:5500

LOG_LEVEL=INFO

ANALYSIS_PROMPT_VERSION=1.0
