# "openrouter" (default/production) or "ollama" (fast local dev iteration only)
LLM_PROVIDER=openrouter

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b:free
OPENROUTER_SITE_URL=http://localhost:5500
OPENROUTER_APP_NAME=LQMS-AI

# Only used when LLM_PROVIDER=ollama. Requires `ollama serve` running locally with this
# model pulled (`ollama pull qwen2.5:7b-instruct-q4_K_M`).
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M
OLLAMA_BASE_URL=http://localhost:11434/v1

INTERNAL_API_KEY=devkey123

ALLOWED_ORIGINS=http://localhost:5500

LOG_LEVEL=INFO

ANALYSIS_PROMPT_VERSION=1.0
